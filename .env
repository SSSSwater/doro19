# ===== 页面与加载 =====
# 浏览器标签页中显示的网页标题。
VITE_TEXT_PAGE_TITLE=doro Project
# 网页的简短描述，供浏览器、搜索引擎或分享预览读取。
VITE_TEXT_PAGE_DESCRIPTION=doro Project
# 加载界面尚未完成时显示的状态文字。
VITE_TEXT_LOADING_PREPARING=准备中
# 加载界面资源加载完成后显示的状态文字。
VITE_TEXT_LOADING_READY=准备完了
# 加载进度条供屏幕阅读器读取的名称。
VITE_TEXT_LOADING_PROGRESS_ARIA=页面加载进度
# 加载完成后进入生日页面的按钮文字。
VITE_TEXT_LOADING_ENTER_BUTTON=开门
# 进入主界面后右下角显示的音量提醒。
VITE_TEXT_VOLUME_REMINDER=呃，没开音量的话给我打开音量
# 加载遮罩淡出到生日页面的时长，同时控制遮罩淡出动效。
VITE_WAIT_LOADING_FADE_MS=1500
# 主界面露出后，等待多久弹出音量提醒。
VITE_WAIT_VOLUME_REMINDER_DELAY_MS=1000
# 音量提醒保持可见的时间。
VITE_WAIT_VOLUME_REMINDER_VISIBLE_MS=5000
# 加载界面药丸装饰的动画时长。
VITE_MOTION_LOADING_PILL_MS=3000
# 加载界面闪光装饰的动画时长。
VITE_MOTION_LOADING_SPARK_MS=1500
# 加载完成后的进入按钮动效时长。
VITE_MOTION_LOADING_ENTER_MS=550
# 音量提醒滑入和滑出的动效时长。
VITE_MOTION_VOLUME_REMINDER_MS=520

